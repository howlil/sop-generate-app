# Mock vs real API. Hanya di data layer (services/index atau adapter) swap berdasarkan flag ini.
# Jangan pakai if (VITE_USE_MOCK) di hook atau component.
VITE_USE_MOCK=false

# API base URL (required when VITE_USE_MOCK=false)
# Development: http://localhost:3000/api/v1
# Production: https://your-api-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1
