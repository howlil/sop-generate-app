# Environment khusus integration test.
# Aman untuk dicommit karena hanya memakai kredensial database test lokal/container.

NODE_ENV=test
PORT=3001
SWAGGER_ENABLED=false

JWT_SECRET=this-is-a-super-secret-key-that-is-at-least-32-characters-long-for-test
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
TTE_ENCRYPTION_SECRET=this-is-a-dedicated-tte-encryption-secret-for-test-only

# Default untuk menjalankan test dari host. Docker Compose akan override host/URL ke service database.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3308
DATABASE_USER=sop_test
DATABASE_PASSWORD=sop_test_password
DATABASE_NAME=sop_biro_organisasi_test
DATABASE_URL=mysql://sop_test:sop_test_password@127.0.0.1:3308/sop_biro_organisasi_test

TTE_SIGNING_SECRET=test-tte-signing-secret-at-least-32-characters-long
PUBLIC_APP_ORIGIN=http://localhost:5173

# Default WhatsApp test tidak mengirim ke layanan asli.
# Suite whatsapp-reminder-e2e.integration-spec.ts override base URL ke HTTP stub lokal.
WHATSAPP_ENABLED=true
WHAAPI_BASE_URL=http://localhost:9999
WHAAPI_TOKEN=test-token
WHAAPI_CHANNEL_ID=test-channel
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_RECONCILE_INTERVAL_SECONDS=10
WHATSAPP_REMINDER_INTERVAL_MINUTES=1
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_MAX_CONCURRENCY=3
WHATSAPP_LOCK_LEASE_SECONDS=60


# Dinonaktifkan default; suite tte-pdf-qr-verifikasi.integration-spec.ts mengaktifkan di beforeAll.
PDF_SIGNING_ENABLED=false
PDF_SIGNING_P12_BASE64=
PDF_SIGNING_P12_PASSPHRASE=
PDF_SIGNING_REASON=Pengesahan dokumen SOP
PDF_SIGNING_LOCATION=Indonesia
PDF_SIGNING_CONTACT=
