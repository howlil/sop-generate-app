datasource db {
  provider = "mysql"
}

generator client {
  provider       = "prisma-client-js"
  output         = "../src/generated/prisma"
  jsModuleFormat = "cjs"
}

enum PeranPengguna {
  BIRO_ORGANISASI
  TIM_EVALUASI
  TIM_PENYUSUN
  KEPALA_OPD
}

enum StatusSOP {
  DRAFT
  SEDANG_DISUSUN
  SIAP_DIEVALUASI
  DIAJUKAN_EVALUASI
  SEDANG_DIEVALUASI
  REVISI_DARI_TIM_EVALUASI
  SIAP_DIVERIFIKASI
  DIVERIFIKASI_BIRO_ORGANISASI
  BERLAKU
  DICABUT
}

enum JenisLangkahProsedur {
  TERMINATOR
  TASK
  DECISION
}

enum StatusPeraturan {
  BERLAKU
  DICABUT
}

enum PeranTTE {
  KEPALA_OPD
  BIRO_ORGANISASI
  TIM_PENYUSUN
}

enum AksiAudit {
  BUAT_SOP
  SIMPAN_DRAFT
  SELESAI_PENYUSUNAN
  AJUKAN_EVALUASI
  MULAI_EVALUASI
  KIRIM_HASIL_EVALUASI
  VERIFIKASI_BATCH
  TTD_BA_KEPALA_OPD
  SAHKAN_SOP
  CABUT_SOP
  REVISI_DARI_EVALUATOR
}

enum StatusTim {
  AKTIF
  NONAKTIF
}

enum PeranInternal {
  KOORDINATOR
  ANGGOTA
}

enum StatusEvaluasi {
  AKTIF
  SELESAI
  TERVERIFIKASI
}

enum JenisBatch {
  TERJADWAL
  MANDIRI
}

enum HasilEvaluasi {
  SESUAI
  PERLU_PERBAIKAN
  REVISI_BIRO
}

enum StatusKomentar {
  OPEN
  RESOLVED
}

// Tabel 1: Pengguna
model Pengguna {
  id             String         @id @default(uuid())
  surel          String         @unique
  nama           String
  sandi          String
  peran          PeranPengguna
  opdId          String?
  nip            String?
  jabatan        String?
  pangkat        String?
  nohp           String?
  dibuatPada     DateTime       @default(now())
  diperbaruiPada DateTime       @updatedAt

  opd              OPD?                 @relation(fields: [opdId], references: [id], onDelete: Restrict)
  timPenyusun      TimPenyusun[]
  timEvaluasi      TimEvaluasiAnggota[]
  profilTTE        ProfilTTE?
  tandaTanganTTE   TandaTanganTTE[]
  logAudit         LogAudit[]
  sopDibuat        SOP[]                @relation("SOPDibuatOleh")
  sopDiedit        SOP[]                @relation("SOPDieditOleh")
  sopSebagaiPic    SOP[]                @relation("SOPPicPengguna")
  peraturanDibuat  Peraturan[]
  batchDiverifikasi BatchVerifikasi[]   @relation("BatchDiverifikasiOleh")
  batchDitandatangani BatchVerifikasi[] @relation("BatchDitandatanganiOlehKoordinator")
  itemEvaluasi     ItemEvaluasi[]       @relation("EvaluasiEvaluator")
  komentar         Komentar[]

  @@index([opdId])
  @@map("Pengguna")
}

// Tabel 2: OPD
model OPD {
  id             String            @id @default(uuid())
  nama           String
  surel          String?
  telepon        String?
  kode           String            @unique
  dibuatPada     DateTime          @default(now())
  diperbaruiPada DateTime          @updatedAt

  pengguna        Pengguna[]
  sop             SOP[]
  pelaksana       Pelaksana[]
  timPenyusun     TimPenyusun[]
  batchVerifikasi BatchVerifikasi[]
}

// Tabel 3: Peraturan
model Peraturan {
  id          String          @id @default(uuid())
  nomor       String
  tahun       Int
  tentang     String          @db.Text
  status      StatusPeraturan @default(BERLAKU)
  versi       Int             @default(1)
  tautanBerkas String?
  dibuatOlehId String?
  dibuatPada  DateTime        @default(now())
  diperbaruiPada DateTime     @updatedAt

  dibuatOleh Pengguna? @relation(fields: [dibuatOlehId], references: [id], onDelete: Restrict)
  sop      SOP[]

  @@index([dibuatOlehId])
}

// Tabel 4: SOP
model SOP {
  id               String    @id @default(uuid())
  nomorSOP         String?   @unique
  judul            String
  status           StatusSOP @default(DRAFT)
  opdId            String
  peraturanId      String?
  versi            Int       @default(1)
  picUserId        String?
  namaPic          String?
  nomorPic         String?
  peranPic         String?
  bagian           String?
  peringatan       String?   @db.Text
  barisInstitusi   String?   @db.Text
  dibuatOlehId     String?
  terakhirDieditOlehId String?
  dibuatPada       DateTime  @default(now())
  diperbaruiPada   DateTime  @updatedAt

  opd                OPD        @relation(fields: [opdId], references: [id], onDelete: Restrict)
  peraturan          Peraturan? @relation(fields: [peraturanId], references: [id], onDelete: SetNull)
  dibuatOleh         Pengguna?  @relation("SOPDibuatOleh", fields: [dibuatOlehId], references: [id], onDelete: Restrict)
  terakhirDieditOleh Pengguna?  @relation("SOPDieditOleh", fields: [terakhirDieditOlehId], references: [id], onDelete: Restrict)
  picUser            Pengguna?  @relation("SOPPicPengguna", fields: [picUserId], references: [id], onDelete: Restrict)

  dasarHukum              DasarHukum[]
  peralatan               Peralatan[]
  dataRekaman             DataRekaman[]
  barisProsedur           BarisProsedur[]
  itemEvaluasi            ItemEvaluasi[]
  logAudit                LogAudit[]
  kualifikasiPelaksanaan  KualifikasiPelaksanaan[]
  komentar                Komentar[]
  tandaTanganTTE          TandaTanganTTE[]

  sopTerkait        SopTerkait[] @relation("RelasiSOP")
  terkaitOlehSOP    SopTerkait[] @relation("RelasiSOPTerkait")

  @@index([opdId, status])
  @@index([peraturanId])
  @@index([dibuatOlehId])
  @@index([terakhirDieditOlehId])
  @@index([picUserId])
}

// Tabel 5: DasarHukum
model DasarHukum {
  id    String @id @default(uuid())
  sopId String
  teks  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
  @@map("DasarHukum")
}

// Tabel 6: Peralatan
model Peralatan {
  id    String @id @default(uuid())
  sopId String
  teks  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
  @@map("Peralatan")
}

// Tabel 7: DataRekaman
model DataRekaman {
  id    String @id @default(uuid())
  sopId String
  teks  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
  @@map("DataRekaman")
}

// Tabel 8: SopTerkait
model SopTerkait {
  sopId        String
  sopTerkaitId String

  sop        SOP @relation("RelasiSOP", fields: [sopId], references: [id], onDelete: Cascade)
  sopTerkait SOP @relation("RelasiSOPTerkait", fields: [sopTerkaitId], references: [id], onDelete: Cascade)

  @@id([sopId, sopTerkaitId])
  @@index([sopTerkaitId])
  @@map("SopTerkait")
}

// Tabel 9: BarisProsedur
model BarisProsedur {
  id              String           @id @default(uuid())
  sopId           String
  nomor           Int
  kegiatan        String           @db.Text
  jenis           JenisLangkahProsedur @default(TASK)
  mutuKelengkapan String?          @db.Text
  mutuWaktu       String?
  keluaran        String?          @db.Text
  keterangan      String?          @db.Text
  waktu           Int?
  satuanWaktu     String?
  urutan          Int
  langkahSelanjutnyaYaId String?
  langkahSelanjutnyaTidakId String?
  dibuatPada      DateTime         @default(now())
  diperbaruiPada  DateTime         @updatedAt

  sop          SOP             @relation(fields: [sopId], references: [id], onDelete: Cascade)
  langkahYa  BarisProsedur?    @relation("LangkahYa", fields: [langkahSelanjutnyaYaId], references: [id], onDelete: SetNull)
  langkahTidak BarisProsedur?  @relation("LangkahTidak", fields: [langkahSelanjutnyaTidakId], references: [id], onDelete: SetNull)
  langkahSebelumYa BarisProsedur[] @relation("LangkahYa")
  langkahSebelumTidak BarisProsedur[] @relation("LangkahTidak")

  pelaksana BarisProsedurPelaksana[]

  @@unique([sopId, urutan])
  @@index([sopId, urutan])
  @@map("BarisProsedur")
}

// Tabel 10: Pelaksana
model Pelaksana {
  id          String   @id @default(uuid())
  namaLengkap String
  nip         String?
  jabatan     String?
  pangkat     String?
  surel       String?
  nohp        String?
  deskripsi   String?  @db.Text
  opdId       String
  dibuatPada  DateTime @default(now())
  diperbaruiPada DateTime @updatedAt

  opd          OPD                      @relation(fields: [opdId], references: [id], onDelete: Restrict)
  barisProsedur BarisProsedurPelaksana[]

  @@index([opdId])
}

// Tabel 11: BarisProsedurPelaksana
model BarisProsedurPelaksana {
  barisProsedurId String
  pelaksanaId     String

  barisProsedur BarisProsedur @relation(fields: [barisProsedurId], references: [id], onDelete: Cascade)
  pelaksana     Pelaksana     @relation(fields: [pelaksanaId], references: [id], onDelete: Restrict)

  @@id([barisProsedurId, pelaksanaId])
  @@index([pelaksanaId])
  @@map("BarisProsedurPelaksana")
}

// Tabel 12: TimPenyusun
model TimPenyusun {
  id               String       @id @default(uuid())
  userId           String
  opdId            String
  status           StatusTim    @default(AKTIF)
  peranInternal    PeranInternal @default(ANGGOTA)
  tanggalBergabung DateTime     @default(now())
  berakhirPada     DateTime?
  dibuatPada       DateTime     @default(now())
  diperbaruiPada   DateTime     @updatedAt

  user Pengguna @relation(fields: [userId], references: [id], onDelete: Restrict)
  opd  OPD      @relation(fields: [opdId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([opdId])
}

// Tabel 13: TimEvaluasiAnggota
model TimEvaluasiAnggota {
  id               String    @id @default(uuid())
  userId           String
  status           StatusTim @default(AKTIF)
  tanggalBergabung DateTime  @default(now())
  berakhirPada     DateTime?
  dibuatPada       DateTime  @default(now())
  diperbaruiPada   DateTime  @updatedAt

  user Pengguna @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// Tabel 14: BatchVerifikasi
model BatchVerifikasi {
  id                        String         @id @default(uuid())
  opdId                     String
  jenis                     JenisBatch
  status                    StatusEvaluasi @default(AKTIF)
  catatan                   String?        @db.Text
  nomorBA                   String?
  tanggalPermintaan         DateTime?
  tanggalEvaluasi           DateTime?
  nilaiOPD                  Int?
  diverifikasiOlehUserId    String?
  ditandatanganiOlehKoordinatorUserId String?
  sudahDitandatanganiKoordinator Boolean  @default(false)
  tanggalTTDBaKoordinator   DateTime?
  dibuatPada                DateTime       @default(now())
  diperbaruiPada            DateTime       @updatedAt

  opd                     OPD              @relation(fields: [opdId], references: [id], onDelete: Restrict)
  diverifikasiOlehUser    Pengguna?        @relation("BatchDiverifikasiOleh", fields: [diverifikasiOlehUserId], references: [id], onDelete: Restrict)
  ditandatanganiOlehKoordinatorUser Pengguna? @relation("BatchDitandatanganiOlehKoordinator", fields: [ditandatanganiOlehKoordinatorUserId], references: [id], onDelete: Restrict)
  itemEvaluasi            ItemEvaluasi[]
  tandaTanganTTE          TandaTanganTTE[]

  @@index([opdId])
  @@index([diverifikasiOlehUserId])
  @@index([ditandatanganiOlehKoordinatorUserId])
  @@map("BatchVerifikasi")
}

// Tabel 15: ItemEvaluasi
model ItemEvaluasi {
  id          String         @id @default(uuid())
  batchId     String
  sopId       String
  evaluatorId String
  hasil       HasilEvaluasi?
  catatan     String?        @db.Text
  rekomendasi String?        @db.Text
  dibuatPada  DateTime       @default(now())
  diperbaruiPada DateTime    @updatedAt

  batch     BatchVerifikasi @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sop       SOP             @relation(fields: [sopId], references: [id], onDelete: Restrict)
  evaluator Pengguna        @relation("EvaluasiEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([batchId, sopId, evaluatorId])
  @@index([batchId])
  @@index([sopId])
  @@index([evaluatorId])
  @@index([evaluatorId, dibuatPada])
  @@map("EvaluasiItem")
}

// Tabel 16: ProfilTTE
model ProfilTTE {
  id                String   @id @default(uuid())
  userId            String   @unique
  hashPin           String
  surelTerverifikasi Boolean  @default(false)
  peran             PeranTTE
  tokenVerifikasi   String?
  dibuatPada        DateTime @default(now())
  diperbaruiPada    DateTime @updatedAt

  user Pengguna @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("ProfilTTE")
}

// Tabel 17: TandaTanganTTE
model TandaTanganTTE {
  id            String   @id @default(uuid())
  userId        String
  peran         PeranTTE
  idDokumen     String
  labelDokumen  String
  idReferensi   String
  hashDokumen   String
  sopId         String?
  batchId       String?
  ditandatanganiPada DateTime @default(now())

  user  Pengguna         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sop   SOP?             @relation(fields: [sopId], references: [id], onDelete: Restrict)
  batch BatchVerifikasi? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sopId])
  @@index([batchId])
  @@map("TandaTanganTTE")
}

// Tabel 18: LogAudit
model LogAudit {
  id            String      @id @default(uuid())
  sopId         String
  aksi          AksiAudit
  aktorId       String
  peranAktor    PeranPengguna
  statusSebelum StatusSOP?
  statusSesudah StatusSOP
  keterangan    String?     @db.Text
  dibuatPada    DateTime    @default(now())

  sop   SOP      @relation(fields: [sopId], references: [id], onDelete: Restrict)
  aktor Pengguna @relation(fields: [aktorId], references: [id], onDelete: Restrict)

  @@index([sopId, dibuatPada])
  @@index([aktorId, dibuatPada])
  @@map("LogAudit")
}

// Tabel 19: KualifikasiPelaksanaan
model KualifikasiPelaksanaan {
  id    String @id @default(uuid())
  sopId String
  teks  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
  @@map("KualifikasiPelaksanaan")
}

// Tabel 20: Komentar
model Komentar {
  id        String         @id @default(uuid())
  sopId     String
  userId    String
  peran     String
  isi       String         @db.Text
  bagian    String?
  status    StatusKomentar @default(OPEN)
  dibuatPada DateTime      @default(now())
  diperbaruiPada DateTime  @updatedAt

  sop  SOP      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  user Pengguna @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sopId, status, dibuatPada])
  @@index([userId])
}
