
datasource db {
  provider = "mysql"
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  jsModuleFormat = "cjs"
}

enum UserRole {
  BIRO_ORGANISASI
  TIM_EVALUASI
  TIM_PENYUSUN
  KEPALA_OPD
}

enum StatusSOP {
  DRAFT
  SEDANG_DISUSUN
  SIAP_DIEVALUASI
  DIAJUKAN_EVALUASI
  SEDANG_DIEVALUASI
  REVISI_DARI_TIM_EVALUASI
  SIAP_DIVERIFIKASI
  DIVERIFIKASI_BIRO_ORGANISASI
  BERLAKU
  DICABUT
}

enum ProsedurStepType {
  TERMINATOR
  TASK
  DECISION
}

enum StatusPeraturan {
  BERLAKU
  DICABUT
}

enum TTERole {
  KEPALA_OPD
  BIRO_ORGANISASI
  TIM_PENYUSUN
}

enum AuditAction {
  BUAT_SOP
  SIMPAN_DRAFT
  SELESAI_PENYUSUNAN
  AJUKAN_EVALUASI
  MULAI_EVALUASI
  KIRIM_HASIL_EVALUASI
  VERIFIKASI_BATCH
  TTD_BA_KEPALA_OPD
  SAHKAN_SOP
  CABUT_SOP
  REVISI_DARI_EVALUATOR
}

enum StatusTim {
  AKTIF
  NONAKTIF
}

enum RoleInternal {
  KOORDINATOR
  ANGGOTA
}

enum StatusEvaluasi {
  AKTIF
  SELESAI
  TERVERIFIKASI
}

enum JenisBatch {
  TERJADWAL
  MANDIRI
}

enum HasilEvaluasi {
  SESUAI
  REVISI_BIRO
}

enum KomentarStatus {
  OPEN
  RESOLVED
}

// Table 1: User
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  opdId     String?
  nip       String?
  jabatan   String?
  pangkat   String?
  nohp      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opd              OPD?               @relation(fields: [opdId], references: [id], onDelete: Restrict)
  timPenyusun      TimPenyusun[]
  timEvaluasi      TimEvaluasiAnggota[]
  tteProfile       TTEProfile?
  tteSignatures    TTESignature[]
  auditLogs        AuditLog[]
  sopsCreated      SOP[]              @relation("SOPCreatedBy")
  sopsEdited       SOP[]              @relation("SOPLastEditedBy")
  sopsAsPic        SOP[]              @relation("SOPPicUser")
  peraturanCreated Peraturan[]
  batchesVerified  VerifikasiBatch[]  @relation("BatchVerifiedBy")
  batchesSigned    VerifikasiBatch[]  @relation("BatchSignedByKoordinator")
  evaluasiItems    EvaluasiItem[]     @relation("EvaluasiEvaluator")
  komentars        Komentar[]

  @@index([opdId])
}

// Table 2: OPD
model OPD {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  kode      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  sops            SOP[]
  pelaksana       Pelaksana[]
  timPenyusun     TimPenyusun[]
  verifikasiBatch VerifikasiBatch[]
}

// Table 3: Peraturan
model Peraturan {
  id          String          @id @default(uuid())
  nomor       String
  tahun       Int
  tentang     String          @db.Text
  status      StatusPeraturan @default(BERLAKU)
  version     Int             @default(1)
  fileUrl     String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sops      SOP[]

  @@index([createdById])
}

// Table 4: SOP (SOPMetadata fields merged into SOP -- 1:1 normalization decision)
// PIC: prefer picUserId (FK to User) when PIC is a system user; picName/picNumber/picRole for external or legacy snapshot text.
model SOP {
  id               String    @id @default(uuid())
  nomorSOP         String?   @unique
  judul            String
  status           StatusSOP @default(DRAFT)
  opdId            String
  peraturanId      String?
  versi            Int       @default(1)
  picUserId        String?
  picName          String?
  picNumber        String?
  picRole          String?
  section          String?
  warning          String?   @db.Text
  institutionLines String?   @db.Text
  createdById      String?
  lastEditedById   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  opd          OPD        @relation(fields: [opdId], references: [id], onDelete: Restrict)
  peraturan    Peraturan? @relation(fields: [peraturanId], references: [id], onDelete: SetNull)
  createdBy    User?      @relation("SOPCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedBy User?      @relation("SOPLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  picUser      User?      @relation("SOPPicUser", fields: [picUserId], references: [id], onDelete: Restrict)

  lawBasis                 LawBasis[]
  equipment                Equipment[]
  recordData               RecordData[]
  prosedurRows             ProsedurRow[]
  evaluasiItems            EvaluasiItem[]
  auditLogs                AuditLog[]
  implementQualifications  ImplementQualification[]
  komentars                Komentar[]
  tteSignatures            TTESignature[]

  relatedSOPs   RelatedSOP[] @relation("SOPRelations")
  relatedBySOPs RelatedSOP[] @relation("RelatedSOPRelations")

  @@index([opdId, status])
  @@index([peraturanId])
  @@index([createdById])
  @@index([lastEditedById])
  @@index([picUserId])
}

// Table 5: LawBasis
model LawBasis {
  id    String @id @default(uuid())
  sopId String
  text  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// Table 6: Equipment
model Equipment {
  id    String @id @default(uuid())
  sopId String
  text  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// Table 7: RecordData
model RecordData {
  id    String @id @default(uuid())
  sopId String
  text  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// Table 8: RelatedSOP (self-referential M:M join table)
model RelatedSOP {
  sopId        String
  relatedSopId String

  sop        SOP @relation("SOPRelations", fields: [sopId], references: [id], onDelete: Cascade)
  relatedSop SOP @relation("RelatedSOPRelations", fields: [relatedSopId], references: [id], onDelete: Cascade)

  @@id([sopId, relatedSopId])
}

// Table 9: ProsedurRow
model ProsedurRow {
  id              String           @id @default(uuid())
  sopId           String
  no              Int
  kegiatan        String           @db.Text
  type            ProsedurStepType @default(TASK)
  mutuKelengkapan String?          @db.Text
  mutuWaktu       String?
  output          String?          @db.Text
  keterangan      String?          @db.Text
  time            Int?
  timeUnit        String?
  order           Int
  nextStepYesId   String?
  nextStepNoId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sop          SOP           @relation(fields: [sopId], references: [id], onDelete: Cascade)
  nextStepYes  ProsedurRow?  @relation("YesStep", fields: [nextStepYesId], references: [id], onDelete: SetNull)
  nextStepNo   ProsedurRow?  @relation("NoStep", fields: [nextStepNoId], references: [id], onDelete: SetNull)
  prevYesSteps ProsedurRow[] @relation("YesStep")
  prevNoSteps  ProsedurRow[] @relation("NoStep")

  pelaksana ProsedurRowPelaksana[]

  @@index([sopId])
}

// Table 10: Pelaksana
model Pelaksana {
  id          String   @id @default(uuid())
  namaLengkap String
  nip         String?
  jabatan     String?
  pangkat     String?
  email       String?
  nohp        String?
  deskripsi   String?  @db.Text
  opdId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opd          OPD                   @relation(fields: [opdId], references: [id], onDelete: Restrict)
  prosedurRows ProsedurRowPelaksana[]

  @@index([opdId])
}

// Table 11: ProsedurRowPelaksana (M:M join)
model ProsedurRowPelaksana {
  prosedurRowId String
  pelaksanaId   String

  prosedurRow ProsedurRow @relation(fields: [prosedurRowId], references: [id], onDelete: Cascade)
  pelaksana   Pelaksana   @relation(fields: [pelaksanaId], references: [id], onDelete: Restrict)

  @@id([prosedurRowId, pelaksanaId])
}

// Table 12: TimPenyusun
model TimPenyusun {
  id               String       @id @default(uuid())
  userId           String
  opdId            String
  status           StatusTim    @default(AKTIF)
  roleInternal     RoleInternal @default(ANGGOTA)
  tanggalBergabung DateTime     @default(now())
  endedAt          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  opd  OPD  @relation(fields: [opdId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([opdId])
}

// Table 13: TimEvaluasiAnggota
model TimEvaluasiAnggota {
  id               String    @id @default(uuid())
  userId           String
  status           StatusTim @default(AKTIF)
  tanggalBergabung DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// Table 14: VerifikasiBatch -- verifikasi BA: Biro lalu Koordinator (isSignedByKoordinator); pengesahan SOP hanya Kepala OPD (bukan kolom di sini).
model VerifikasiBatch {
  id                        String         @id @default(uuid())
  opdId                     String
  jenis                     JenisBatch
  status                    StatusEvaluasi @default(AKTIF)
  catatan                   String?        @db.Text
  nomorBA                   String?
  tanggalRequest            DateTime?
  tanggalEvaluasi           DateTime?
  nilaiOPD                  Int?
  verifiedByUserId          String?
  signedByKoordinatorUserId String?
  isSignedByKoordinator     Boolean        @default(false)
  tanggalTTDBaByKoordinator DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  opd                     OPD    @relation(fields: [opdId], references: [id], onDelete: Restrict)
  verifiedByUser          User?  @relation("BatchVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  signedByKoordinatorUser User?  @relation("BatchSignedByKoordinator", fields: [signedByKoordinatorUserId], references: [id], onDelete: Restrict)
  evaluasiItems           EvaluasiItem[]
  tteSignatures           TTESignature[]

  @@index([opdId])
  @@index([verifiedByUserId])
  @@index([signedByKoordinatorUserId])
}

// Table 15: EvaluasiItem
model EvaluasiItem {
  id          String         @id @default(uuid())
  batchId     String
  sopId       String
  evaluatorId String
  hasil       HasilEvaluasi?
  catatan     String?        @db.Text
  rekomendasi String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  batch     VerifikasiBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sop       SOP             @relation(fields: [sopId], references: [id], onDelete: Restrict)
  evaluator User            @relation("EvaluasiEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([sopId])
  @@index([evaluatorId])
}

// Table 16: TTEProfile -- identity fields (nip, jabatan, pangkat, nohp) live on User only (3NF single source of truth).
model TTEProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  pinHash           String
  emailVerified     Boolean  @default(false)
  role              TTERole
  verificationToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Table 17: TTESignature
model TTESignature {
  id            String   @id @default(uuid())
  userId        String
  role          TTERole
  documentId    String
  documentLabel String
  referenceId   String
  documentHash  String
  sopId         String?
  batchId       String?
  signedAt      DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sop   SOP?             @relation(fields: [sopId], references: [id], onDelete: Restrict)
  batch VerifikasiBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sopId])
  @@index([batchId])
}

// Table 18: AuditLog
model AuditLog {
  id            String      @id @default(uuid())
  sopId         String
  action        AuditAction
  aktorId       String
  aktorRole     UserRole
  statusSebelum StatusSOP?
  statusSesudah StatusSOP
  keterangan    String?     @db.Text
  createdAt     DateTime    @default(now())

  sop   SOP  @relation(fields: [sopId], references: [id], onDelete: Restrict)
  aktor User @relation(fields: [aktorId], references: [id], onDelete: Restrict)

  @@index([sopId])
  @@index([aktorId])
}

// Table 19: ImplementQualification
model ImplementQualification {
  id    String @id @default(uuid())
  sopId String
  text  String @db.Text

  sop SOP @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@index([sopId])
}

// Table 20: Komentar
model Komentar {
  id        String         @id @default(uuid())
  sopId     String
  userId    String
  role      String
  isi       String         @db.Text
  bagian    String?
  status    KomentarStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  sop  SOP  @relation(fields: [sopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sopId])
  @@index([userId])
}
