generator client {
  provider       = "prisma-client-js"
  output         = "../src/generated/prisma"
  jsModuleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// =========================
/// MODUL 1 — MASTER & AKSES
/// =========================
model Pengguna {
  penggunaId                      String               @id @default(uuid())
  email                           String               @unique
  opdId                           String
  nama                            String
  kataSandi                       String
  peran                           PeranPengguna
  nip                             String               @unique
  jabatan                         String
  pangkat                         String
  nohp                            String
  ttePinHash                      String?              @db.VarChar(255)
  ttePinSetAt                     DateTime?
  deletedAt                       DateTime?
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  detailSopDibuat                 DetailSOP[]          @relation("SOPDibuatOleh")
  detailSopDiedit                 DetailSOP[]          @relation("SOPDieditOleh")
  komentar                        Komentar[]
  logEditSop                      LogEditSOP[]
  logNilaiEvaluasi                LogNilaiEvaluasi[]
  nilaiEvaluasiDiisi              NilaiEvaluasi[]      @relation("NilaiDiisiOleh")
  pengajuanEvaluasiDiselesaikan   PengajuanEvaluasi[]  @relation("PengajuanDiselesaikanOleh")
  pengajuanEvaluasiDitandatangani PengajuanEvaluasi[]  @relation("PengajuanDitandatanganiOlehPjPenyusun")
  pengajuanEvaluasiDiverifikasi   PengajuanEvaluasi[]  @relation("PengajuanDiverifikasiOleh")
  peraturanTerakhirDiedit         Peraturan[]          @relation("PeraturanTerakhirDiedit")
  opd                             OPD                  @relation(fields: [opdId], references: [opdId], onDelete: Restrict)
  riwayatOpd                      RiwayatOpdPengguna[]
  tandaTangan                     RiwayatTandaTangan[]
}

model OPD {
  opdId                String               @id @default(uuid())
  nama                 String
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  pelaksana            Pelaksana[]
  pengajuanEvaluasi    PengajuanEvaluasi[]
  pengguna             Pengguna[]
  riwayatOpdPengguna   RiwayatOpdPengguna[]
  opdPeraturan         OPDPeraturan[]
  sop                  SOP[]
}

model RiwayatOpdPengguna {
  penggunaId           String
  opdId                String
  isAktif              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  opd                  OPD       @relation(fields: [opdId], references: [opdId], onDelete: Restrict)
  pengguna             Pengguna  @relation(fields: [penggunaId], references: [penggunaId], onDelete: Cascade)

  @@id([penggunaId, opdId])

}

/// =========================
/// MODUL 1 — MASTER & AKSES (REGULASI)
/// =========================
model Peraturan {
  peraturanId String         @id @default(uuid())
  nama        String
  nomor       String
  tahun       Int
  tentang     String
  lastEditedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  dasarHukum  DasarHukum[]
  opdPemakai  OPDPeraturan[]
  lastEditedBy Pengguna?     @relation("PeraturanTerakhirDiedit", fields: [lastEditedById], references: [penggunaId], onDelete: SetNull)

  @@unique([nomor, tahun])
  @@index([lastEditedById])
}

model OPDPeraturan {
  opdId       String
  peraturanId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  opd         OPD       @relation(fields: [opdId], references: [opdId], onDelete: Cascade)
  peraturan   Peraturan @relation(fields: [peraturanId], references: [peraturanId], onDelete: Cascade)

  @@id([opdId, peraturanId])
}

/// =========================
/// MODUL 2 — AUTHORING SOP (INTI)
/// =========================
model SOP {
  sopId      String      @id @default(uuid())
  opdId      String
  judul      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  detailSops DetailSOP[]
  opd        OPD         @relation(fields: [opdId], references: [opdId])
}

model DetailSOP {
  detailSopId String @id @default(uuid())
  sopId       String

  status                 StatusSOP            @default(DRAFT)
  versi                  Int                  @default(1)
  nomorSOP               String               @unique
  tanggalPembuatan       DateTime             @default(now())
  tanggalRevisi          DateTime?
  tanggalEfektif         DateTime?
  namaLembaga            String               @db.Text
  dibuatOlehId           String?
  terakhirDieditOlehId   String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  dasarHukum             DasarHukum[]
  dibuatOleh             Pengguna?            @relation("SOPDibuatOleh", fields: [dibuatOlehId], references: [penggunaId], onDelete: Restrict)
  sop                    SOP                  @relation(fields: [sopId], references: [sopId], onDelete: Cascade)
  terakhirDieditOleh     Pengguna?            @relation("SOPDieditOleh", fields: [terakhirDieditOlehId], references: [penggunaId], onDelete: Restrict)
  swimlanes              DetailSOPPelaksana[]
  komentar               Komentar[]
  lampiranPeringatan               LampiranPeringatan[]
  lampiranKualifikasiPelaksanaan   LampiranKualifikasiPelaksanaan[]
  lampiranPeralatanPerlengkapan    LampiranPeralatanPerlengkapan[]
  lampiranPencatatanPendataan      LampiranPencatatanPendataan[]
  langkahSOP             LangkahSOP[]
  logEditSop             LogEditSOP[]
  nilaiEvaluasi          NilaiEvaluasi[]
  relasiSopKeluar        SopTerkait[]         @relation("RelasiSOP")
  relasiSopMasuk         SopTerkait[]         @relation("RelasiSOPTerkait")
  dokumenTte             DokumenTte[]

  @@unique([sopId, versi])
}

/// Lampiran PERINGATAN (ambil teks terbaru untuk tampilan dokumen).
model LampiranPeringatan {
  lampiranPeringatanId String   @id @default(uuid())
  detailSopId    String
  teks           String        @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  detailSop      DetailSOP     @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId, createdAt])
}

model LampiranKualifikasiPelaksanaan {
  lampiranKualifikasiPelaksanaanId String   @id @default(uuid())
  detailSopId                      String
  teks                             String   @db.Text
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  detailSop                        DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId, createdAt])
}

model LampiranPeralatanPerlengkapan {
  lampiranPeralatanPerlengkapanId String   @id @default(uuid())
  detailSopId                     String
  teks                            String   @db.Text
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  detailSop                       DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId, createdAt])
}

model LampiranPencatatanPendataan {
  lampiranPencatatanPendataanId String   @id @default(uuid())
  detailSopId                   String
  teks                          String   @db.Text
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  detailSop                     DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@index([detailSopId, createdAt])
}

model DasarHukum {
  detailSopId String
  peraturanId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  peraturan   Peraturan @relation(fields: [peraturanId], references: [peraturanId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, peraturanId])
}

/// Relasi keluar: `detailSopId` (pemilik) → `detailSopTerkaitId` (target). Invariant DB + app:
/// tidak boleh self-loop; tidak boleh `(B,A)` jika `(A,B)` sudah ada (pasangan terbalik).
model SopTerkait {
  detailSopId        String
  detailSopTerkaitId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sop                DetailSOP @relation("RelasiSOP", fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  sopTerkait         DetailSOP @relation("RelasiSOPTerkait", fields: [detailSopTerkaitId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, detailSopTerkaitId])
}

/// `pelaksanaId` harus dari OPD yang sama dengan SOP pemilik `detailSopId` (trigger DB + validasi prosedur).
model LangkahSOP {
  langkahSopId              String               @id @default(uuid())
  detailSopId               String
  kegiatan                  String               @db.Text
  jenis                     JenisLangkahProsedur @default(KEGIATAN)
  urutan                    Int
  kelengkapan               String
  keluaran                  String
  waktu                     Int
  satuanWaktu               SatuanWaktu
  keterangan                String               @db.Text
  pelaksanaId               String
  langkahSelanjutnyaYaId    String?
  langkahSelanjutnyaTidakId String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  langkahTidak              LangkahSOP?          @relation("LangkahTidak", fields: [langkahSelanjutnyaTidakId], references: [langkahSopId])
  langkahSebelumTidak       LangkahSOP[]         @relation("LangkahTidak")
  langkahYa                 LangkahSOP?          @relation("LangkahYa", fields: [langkahSelanjutnyaYaId], references: [langkahSopId])
  langkahSebelumYa          LangkahSOP[]         @relation("LangkahYa")
  pelaksana                 Pelaksana            @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop                 DetailSOP            @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@unique([detailSopId, urutan])
}

model Pelaksana {
  pelaksanaId   String               @id @default(uuid())
  opdId         String
  nama String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sopDetails    DetailSOPPelaksana[]
  langkahSOP    LangkahSOP[]
  opd           OPD                  @relation(fields: [opdId], references: [opdId])
}

/// Swimlane: `pelaksanaId` harus master `Pelaksana` dengan `opdId` sama seperti `SOP` pemilik `DetailSOP` (trigger DB).
model DetailSOPPelaksana {
  detailSopId String
  pelaksanaId String
  urutan      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pelaksana   Pelaksana @relation(fields: [pelaksanaId], references: [pelaksanaId])
  detailSop   DetailSOP @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)

  @@id([detailSopId, pelaksanaId])
}

  
/// =========================
/// MODUL 3 — KOLABORASI SOP
/// =========================

/// Log aktivitas edit per DetailSOP (kunci alami sesi: detail + pengguna + waktu mulai).
model LogEditSOP {
  detailSopId     String
  penggunaId      String
  createdAt       DateTime               @default(now()) @db.DateTime(3)
  bagian          BagianSOP              @default(HEADER)
  /// Pointer longgar ke entitas yang diaudit (mis. komentarId); bukan FK. Null bila tidak relevan.
  targetEntityId  String?
  /// Ringkasan human-readable yang sudah memuat label bagian + field yang berubah.
  keterangan      String?                @db.Text
  /// Jumlah event yang digabung dalam sesi (bekas `meta.count`).
  sesiChangeCount Int                    @default(1)
  /// Sesi dianggap selesai bila tidak null. Sesi terbuka (null) bisa di-merge dengan edit lanjutan dalam idle window.
  closedAt        DateTime?              @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @db.DateTime(3)
  detailSop       DetailSOP              @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  pengguna        Pengguna               @relation(fields: [penggunaId], references: [penggunaId])
  domainFields    LogEditSopDomainField[]

  @@id([detailSopId, penggunaId, createdAt])
  @@index([detailSopId, penggunaId, bagian, closedAt])
  @@index([detailSopId, createdAt])
}

/// Field domain yang berubah dalam satu sesi log (normalisasi bekas `meta.fields`).
model LogEditSopDomainField {
  detailSopId   String
  penggunaId    String
  logCreatedAt  DateTime    @db.DateTime(3)
  domainField   String      @db.VarChar(191)
  logEditSop    LogEditSOP  @relation(fields: [detailSopId, penggunaId, logCreatedAt], references: [detailSopId, penggunaId, createdAt], onDelete: Cascade)

  @@id([detailSopId, penggunaId, logCreatedAt, domainField])
}

model Komentar {
  komentarId  String         @id @default(uuid())
  detailSopId String
  userId      String
  isi         String         @db.Text
  status      StatusKomentar @default(TERBUKA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  detailSop   DetailSOP      @relation(fields: [detailSopId], references: [detailSopId], onDelete: Cascade)
  user        Pengguna       @relation(fields: [userId], references: [penggunaId])
}


/// =========================
/// MODUL 5 — PENGAJUAN & EVALUASI SOP
/// ======================= ==
model PengajuanEvaluasi {
  pengajuanEvaluasiId                 String                  @id @default(uuid())
  opdId                               String
  jenis                               JenisPengajuanEvaluasi
  status                              StatusPengajuanEvaluasi @default(SEDANG_DIEVALUASI)
  nomorBA                             String?
  tanggalPermintaan                   DateTime?
  tanggalEvaluasi                     DateTime?
  nilaiOPD                            Int?
  diverifikasiOlehUserId              String?
  ditandatanganiOlehPjPenyusunUserId  String?
  tanggalTTDBaPjPenyusun              DateTime?
  /// Evaluator yang men-trigger "selesai evaluasi" → kirim ke PJ Evaluator Organisasi.
  /// Syarat: semua NilaiEvaluasi dalam pengajuan ini sudah terisi hasil.
  diselesaikanOlehId                  String?
  tanggalDiselesaikan                 DateTime?
  /// Versi untuk optimistic locking — increment di setiap update status.
  /// Service: UPDATE ... SET status = ?, version = version + 1 WHERE id = ? AND version = ?
  version                             Int                     @default(0)
  createdAt                           DateTime                @default(now())
  updatedAt                           DateTime                @updatedAt
  logNilaiEvaluasi                    LogNilaiEvaluasi[]
  nilaiEvaluasi                       NilaiEvaluasi[]
  diselesaikanOleh                    Pengguna?               @relation("PengajuanDiselesaikanOleh", fields: [diselesaikanOlehId], references: [penggunaId])
  ditandatanganiOlehPjPenyusunUser    Pengguna?               @relation("PengajuanDitandatanganiOlehPjPenyusun", fields: [ditandatanganiOlehPjPenyusunUserId], references: [penggunaId], onDelete: Restrict)
  diverifikasiOlehUser                Pengguna?               @relation("PengajuanDiverifikasiOleh", fields: [diverifikasiOlehUserId], references: [penggunaId], onDelete: Restrict)
  dokumenTte                          DokumenTte[]
  opd                                 OPD                     @relation(fields: [opdId], references: [opdId])
}

model NilaiEvaluasi {
  pengajuanEvaluasiId String
  detailSopId         String
  hasil               HasilEvaluasi?
  catatan             String?           @db.Text
  version             Int               @default(0)
  dinilaiOlehId       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  dinilaiOleh         Pengguna?         @relation("NilaiDiisiOleh", fields: [dinilaiOlehId], references: [penggunaId])
  pengajuanEvaluasi   PengajuanEvaluasi @relation(fields: [pengajuanEvaluasiId], references: [pengajuanEvaluasiId])
  detailSop           DetailSOP         @relation(fields: [detailSopId], references: [detailSopId])
  logNilaiEvaluasi    LogNilaiEvaluasi[]

  @@id([pengajuanEvaluasiId, detailSopId])
}

model LogNilaiEvaluasi {
  pengajuanEvaluasiId String
  detailSopId         String
  penggunaId          String
  hasilSebelum        HasilEvaluasi?
  hasilSesudah        HasilEvaluasi?
  catatanSebelum      String?           @db.Text
  catatanSesudah      String?           @db.Text
  createdAt           DateTime          @default(now()) @db.DateTime(3)
  pengguna            Pengguna          @relation(fields: [penggunaId], references: [penggunaId])
  pengajuanEvaluasi   PengajuanEvaluasi @relation(fields: [pengajuanEvaluasiId], references: [pengajuanEvaluasiId])
  nilaiEvaluasi       NilaiEvaluasi     @relation(fields: [pengajuanEvaluasiId, detailSopId], references: [pengajuanEvaluasiId, detailSopId], onDelete: Cascade)

  @@id([pengajuanEvaluasiId, detailSopId, penggunaId, createdAt])
  @@index([detailSopId, createdAt])
}

/// =========================
/// MODUL 6 — LEGALISASI & TTE
/// =========================
/// Wajib tepat satu parent: `detailSopId` XOR `pengajuanEvaluasiId` (CHECK MySQL, lihat migrasi invariant).

model DokumenTte {
  dokumenTteId         String             @id @default(uuid())
  nomorDokumen         String
  jenisDokumen         JenisDokumenTte
  judulDokumen         String
  hashDokumen          String
  versiDokumen         Int                @default(1)
  metodeKanonikalisasi String?
  detailSopId          String?
  pengajuanEvaluasiId  String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  detailSop            DetailSOP?         @relation(fields: [detailSopId], references: [detailSopId], onDelete: Restrict)
  pengajuanEvaluasi    PengajuanEvaluasi? @relation(fields: [pengajuanEvaluasiId], references: [pengajuanEvaluasiId], onDelete: Restrict)
  riwayatTandaTangan   RiwayatTandaTangan[]

  @@unique([detailSopId])
  @@unique([pengajuanEvaluasiId])
}

model RiwayatTandaTangan {
  userId               String
  dokumenTteId         String
  peran                PeranPengguna
  signatureValue       String?            @db.LongText
  signatureAlgorithm   String?
  signatureFormat      String?
  keyId                String?
  certSerialNumber     String?
  certIssuer           String?
  certSubject          String?
  certFingerprint      String?
  certValidFrom        DateTime?
  certValidTo          DateTime?
  ditandatanganiPada   DateTime           @default(now())
  dokumenTte           DokumenTte         @relation(fields: [dokumenTteId], references: [dokumenTteId], onDelete: Restrict)
  user                 Pengguna           @relation(fields: [userId], references: [penggunaId])

  @@id([userId, dokumenTteId])
  @@unique([dokumenTteId, peran])
}

/// =========================
/// ENUMS
/// =========================
enum PeranPengguna {
  PJ_EVALUATOR
  EVALUATOR
  KEPALA_OPD
  PJ_PENYUSUN
  PENYUSUN
}

enum StatusSOP {
  DRAFT
  SEDANG_DISUSUN
  SIAP_DIEVALUASI
  DIAJUKAN_EVALUASI
  SEDANG_DIEVALUASI
  REVISI_DARI_EVALUATOR
  SIAP_DIVERIFIKASI
  DIVERIFIKASI_PJ_EVALUATOR_ORGANISASI
  /// Versi aktif yang sah — hanya 1 versi BERLAKU per SOP (enforce via trigger, lihat SCHEMA-CONSTRAINTS.md)
  BERLAKU
  /// Versi lama yang digantikan versi baru. Set otomatis saat versi baru menjadi BERLAKU.
  DIGANTIKAN
  DICABUT
}

enum JenisLangkahProsedur {
  AWAL_AKHIR
  KEGIATAN
  KEPUTUSAN
}

enum SatuanWaktu {
  m
  h
  d
  w
  mo
  y
}

enum JenisPengajuanEvaluasi {
  TERJADWAL
  MANDIRI
}

enum StatusPengajuanEvaluasi {
  SEDANG_DIEVALUASI
  SELESAI_DIEVALUASI
  DIVERIFIKASI_PJ_EVALUATOR
  DITANDATANGANI_PJ_PENYUSUN
  SELESAI
}

enum HasilEvaluasi {
  SESUAI
  PERLU_PERBAIKAN
}

enum JenisDokumenTte {
  BERITA_ACARA_EVALUASI
  SOP_BERLAKU
}

enum StatusKomentar {
  TERBUKA
  SELESAI
}

/// Kategori bagian SOP yang menjadi sumber log aktivitas / komentar.
enum BagianSOP {
  HEADER
  LANGKAH
  STATUS
  KOMENTAR
  EVALUASI
}

