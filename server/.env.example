# Database
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=yourpassword
DATABASE_NAME=yourdb
DATABASE_URL=mysql://root:yourpassword@localhost:3306/yourdb

# Server
PORT=3000
NODE_ENV=development

# JWT (optional - for auth)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=1d

# CORS (for production)
ALLOWED_ORIGINS=https://domain-kamu.com,https://api.domain-kamu.com
