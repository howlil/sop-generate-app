# Isi variabel ini pada Environment service Compose di Easypanel.
# DATABASE_* di backend diisi otomatis dari DB_* via docker-compose.prod.yml.

# --- Versi image lokal; Easypanel membangun image dari commit branch aktif ---
APP_VERSION=local

# --- MariaDB (service: db) ---
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD
DB_NAME=sop_biro_organisasi
DB_USER=sop_app
DB_PASSWORD=GANTI_DB_PASSWORD
# Seed berisi data demo dan akun default. Biarkan false untuk production.
RUN_DB_SEED_ON_START=false

# --- JWT (wajib; JWT_REFRESH_SECRET min 32 karakter di production) ---
JWT_SECRET=GANTI_JWT_SECRET_MINIMAL_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_JWT_REFRESH_SECRET_MINIMAL_32_KARAKTER
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SWAGGER_ENABLED=false

# --- Public URL (opsional; dipakai untuk URL QR/verifikasi publik jika tidak bisa dideteksi dari request) ---
PUBLIC_APP_ORIGIN=
ALLOWED_ORIGINS=

# --- Runtime storage (dipersist di named Docker volume sop-arsip-pdf-prod-data) ---
SOP_PDF_STORAGE_DIR=/app/storage/sop-pdf

# --- WhatsApp reminder via WAHA hosted eksternal (nonaktif secara default) ---
WHATSAPP_ENABLED=false
# Hanya backend yang mengakses WAHA. URL ini tidak pernah dikirim ke browser/frontend.
WAHA_BASE_URL=https://waha.howlil.my.id
WAHA_API_KEY=GANTI_API_KEY_MINIMAL_16_KARAKTER
WAHA_SESSION=sop-staging

# Opsional: kosong = seluruh nomor valid dari DB; isi nomor dipisahkan koma untuk staging terbatas.
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_RECONCILE_INTERVAL_SECONDS=10
# Staging/demo: 1 menit. Simulasi harian: 1440 menit.
WHATSAPP_REMINDER_INTERVAL_MINUTES=1
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_MAX_CONCURRENCY=3
WHATSAPP_LOCK_LEASE_SECONDS=60

# --- PDF signing (generate: cd server && node scripts/generate-pdf-signing-cert.cjs "passphrase") ---
PDF_SIGNING_ENABLED=true
PDF_SIGNING_P12_PASSPHRASE=GANTI_PASSPHRASE_SERTIFIKAT
PDF_SIGNING_P12_BASE64=GANTI_DARI_OUTPUT_SCRIPT
