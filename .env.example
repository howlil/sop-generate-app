# Template variabel root untuk Komodo Stack / docker-compose.prod.yml
# Salin ke .env lalu isi nilai produksi: cp .env.example .env

# --- MariaDB (service db) ---
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD
DB_NAME=sop_biro_organisasi
DB_USER=sop_app
DB_PASSWORD=GANTI_DB_PASSWORD

# --- Backend (service backend) ---
NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false
# * = izinkan semua origin (production)
ALLOWED_ORIGINS=*

JWT_SECRET=GANTI_JWT_SECRET_MINIMAL_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_JWT_REFRESH_SECRET_MINIMAL_32_KARAKTER
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=sop_app
DATABASE_PASSWORD=GANTI_DB_PASSWORD
DATABASE_NAME=sop_biro_organisasi
DATABASE_URL=mysql://sop_app:GANTI_DB_PASSWORD@db:3306/sop_biro_organisasi

# Opsional — kosong = deteksi otomatis dari request (Origin / proxy headers)
# PUBLIC_APP_ORIGIN=https://domain-anda.go.id

# Generate: cd server && node scripts/generate-pdf-signing-cert.cjs "passphrase-anda"
PDF_SIGNING_ENABLED=true
PDF_SIGNING_P12_PASSPHRASE=GANTI_PASSPHRASE_SERTIFIKAT
PDF_SIGNING_P12_BASE64=GANTI_DARI_OUTPUT_SCRIPT
PDF_SIGNING_REASON=Pengesahan dokumen SOP
PDF_SIGNING_LOCATION=Sumatera Barat, Indonesia
PDF_SIGNING_CONTACT=Biro Organisasi Sekda Provinsi Sumatera Barat
