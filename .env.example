# Copy to .env for local Docker Compose or the production server.
# Use real secrets only in the server/CI secret store. Do not commit populated secrets.

# MariaDB service: db
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=sop_biro_organisasi
DB_USER=sop_app
DB_PASSWORD=change-me-db-password

# Backend auth. Production requires both secrets to be at least 32 characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SWAGGER_ENABLED=false

# Secret khusus untuk mengenkripsi passphrase sertifikat personal TTE.
# Harus berbeda dari JWT_SECRET dan JWT_REFRESH_SECRET.
TTE_ENCRYPTION_SECRET=change-me-dedicated-tte-encryption-secret-at-least-32-chars

# Public URL/CORS. Production tidak menerima wildcard karena auth memakai cookie credentials.
PUBLIC_APP_ORIGIN=https://sop.example.test
ALLOWED_ORIGINS=https://sop.example.test

# Runtime storage inside the backend container; persisted by the sop_pdf_data volume.
SOP_PDF_STORAGE_DIR=/app/storage/sop-pdf

# Notification reminder shared scheduler. In-app notification tetap dapat aktif tanpa WhatsApp.
NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_RECONCILE_INTERVAL_SECONDS=10

# WhatsApp outbound opsional. Isi token dan channel bersama-sama untuk mengaktifkan;
# biarkan keduanya kosong untuk menonaktifkan WhatsApp.
WHAAPI_BASE_URL=https://whaapi.flobaze.com
WHAAPI_TOKEN=
WHAAPI_CHANNEL_ID=
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_REMINDER_INTERVAL_MINUTES=1440
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_MAX_CONCURRENCY=3
WHATSAPP_LOCK_LEASE_SECONDS=60

# Penandatanganan PDF personal. P12 disimpan per pengguna melalui setup/upload profil TTE.
# Jika false, signature baru dinonaktifkan tetapi verifikasi PDF yang sudah ditandatangani tetap tersedia.
PDF_SIGNING_ENABLED=true
PDF_SIGNING_REASON=Pengesahan dokumen SOP
PDF_SIGNING_LOCATION=Indonesia
PDF_SIGNING_CONTACT=
