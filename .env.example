# Copy to .env for Docker Compose / MyPaas production deployment.
# Keep real secrets in the deployment secret store. Do not commit populated secrets.

# Required: public URL used for CORS and public TTE verification links.
PUBLIC_APP_ORIGIN=https://sop.example.test

# Required: application database password.
# Database name/user and MariaDB root password management are handled internally.
DB_PASSWORD=change-me-db-password

# Required: authentication secrets. Use different random values, minimum 32 characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Required: server secret protecting encrypted personal P12 passphrases.
# Must differ from both JWT secrets and remain stable across deployments/restores.
TTE_ENCRYPTION_SECRET=change-me-dedicated-tte-encryption-secret-at-least-32-chars

# WhatsApp outbound opsional melalui Wago self-hosted.
# Isi URL + API key bersama-sama untuk mengaktifkan; kosongkan keduanya untuk menonaktifkan.
# Nomor receiver harus di-allow secara manual di Wago sebelum SOPFlow dapat mengirim kepadanya.
WAGO_BASE_URL=
WAGO_API_KEY=
